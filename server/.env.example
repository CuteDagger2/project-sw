# Server configuration example
# Copy this file to .env and fill the values you need

# Server
PORT=4000
JWT_SECRET=change_this_secret

# SMTP (for real email sending via nodemailer)
# Use your SMTP provider values here. If these are empty, emails are simulated and printed to console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@yourdomain.com
# Copy to .env and fill values for production/local testing
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=info@saudievents.local
DB_FILE=./data.sqlite
